# Easiest: run "npm run setup". It asks for the first three values and fills in the rest.

# ---------------------------------------------------------------------------
# Kaltura account (KMC > Settings > Integration Settings)
# ---------------------------------------------------------------------------
KALTURA_PARTNER_ID=
# Admin secret. Server-side only, never sent to the browser.
KALTURA_ADMIN_SECRET=
# A Kaltura user who is an Event Platform team member (Admin/Organizer).
# The Events Platform API requires this.
KALTURA_ADMIN_USER_ID=

# NVP (default, North America) | EU | DE
KALTURA_REGION=NVP

# ---------------------------------------------------------------------------
# Event Platform
# ---------------------------------------------------------------------------
# Numeric event ID (shown in the Event Platform URL / event settings)
KALTURA_EVENT_ID=
# Optional: pin a specific session entry ID. If empty, the site picks the
# live-now or next-upcoming LiveWebcast/SimuLive session of the event.
KALTURA_SESSION_ID=

# ---------------------------------------------------------------------------
# Embedded components (uiconfs auto-provisioned on Event Platform accounts)
# ---------------------------------------------------------------------------
# Webcast player, usually "EP All Plugins (Do Not Delete)".
KALTURA_PLAYER_UICONF_ID=
# Chat & Collaboration, usually "KEP widgets - default UIconf for EP - latest".
# NOT the "KEP reactions widgets" uiconf (that one goes in CNC_REACTIONS_SOURCE_URL).
KALTURA_CNC_UICONF_ID=
# The "token" value of the app token whose sessionPrivileges are "cncAuth:true".
# If empty, it is looked up with appToken.list. "npm run setup" can create one.
KALTURA_CNC_APP_TOKEN=
# Optional emoji reactions: embed URL of the "KEP reactions widgets" uiconf, e.g.
# https://cdnapisec.kaltura.com/p/<partnerId>/embedPlaykitJs/uiconf_id/<reactionsUiConfId>
CNC_REACTIONS_SOURCE_URL=

# ---------------------------------------------------------------------------
# Look & feel
# ---------------------------------------------------------------------------
# Shown above the event name on the sign-in page
SITE_TITLE=
# Used by the site and the CnC widget theme (hex)
BRAND_COLOR=#006EFA
# light | dark (CnC widget)
CNC_THEME_MODE=light

# ---------------------------------------------------------------------------
# Website
# ---------------------------------------------------------------------------
PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
KS_EXPIRY_HOURS=12

# local   = passwords managed by this site in users.json (npm run add-user).
#           Works with Event Platform invitations, which don't give attendees a password.
# kaltura = verify against the user's Kaltura login (user.loginByLoginId).
AUTH_MODE=local
# Require the user to be registered for the event in Event Platform (recommended)
REQUIRE_EVENT_REGISTRATION=true
# Sign-in attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=10

# Production: NODE_ENV=production enables secure cookies. Set TRUST_PROXY=true behind a TLS proxy.
NODE_ENV=development
TRUST_PROXY=false
# CSP ships in report-only mode. After a clean test (no violations in the console), set to true.
CSP_ENFORCE=false
